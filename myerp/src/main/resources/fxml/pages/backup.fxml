<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="mainContainer" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.BackupController"
      spacing="20" style="-fx-padding: 24; -fx-background-color: #f8fafc;">

    <!-- Header Section -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Sauvegardes &amp; Migration des Données"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
            <Label text="Exportez votre base de données sur clé USB (.cni) ou restaurez/importez une sauvegarde (.cni, .sql, .db)."
                   style="-fx-font-size: 13px; -fx-text-fill: #64748b;"/>
        </VBox>
        <Label fx:id="lblHostBadge" text="Poste Principal (Serveur)"
               style="-fx-background-color: #dcfce7; -fx-text-fill: #15803d; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 6 12; -fx-background-radius: 999;"/>
    </HBox>

    <!-- Top Action Cards: Export (.cni) & Restore/Import (.cni, .sql, .db) -->
    <GridPane hgap="20" vgap="16">
        <columnConstraints>
            <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS"/>
            <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS"/>
        </columnConstraints>

        <!-- Card 1: Export to .cni -->
        <VBox spacing="12" GridPane.columnIndex="0"
              style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 20;">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="📤" style="-fx-font-size: 20px;"/>
                <Label text="Exporter la base de données (.cni)"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
            </HBox>
            <Label text="Crée une archive sécurisée (.cni) contenant la base de données chiffrée et son manifeste d'intégrité SHA-256. Idéal pour sauvegarder sur une clé USB avant un formatage ou un changement de PC."
                   wrapText="true" style="-fx-font-size: 12.5px; -fx-text-fill: #475569;" VBox.vgrow="ALWAYS"/>
            <HBox alignment="CENTER_RIGHT">
                <Button fx:id="btnExportCni" text="Exporter vers un fichier (.cni)" onAction="#handleExportCni"
                        style="-fx-background-color: #0f766e; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 10 18; -fx-background-radius: 8; -fx-cursor: hand;"/>
            </HBox>
        </VBox>

        <!-- Card 2: Restore (.cni) or Import Legacy (.sql, .db) -->
        <VBox spacing="12" GridPane.columnIndex="1"
              style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 20;">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="📥" style="-fx-font-size: 20px;"/>
                <Label text="Restaurer ou Importer (.cni, .sql, .db)"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
            </HBox>
            <Label text="Restaure une archive (.cni) ou importe les données d'une ancienne version (.sql ou .db SQLite) avec recalcul automatique des soldes et du grand livre des paiements. Une copie de sécurité est créée avant l'opération."
                   wrapText="true" style="-fx-font-size: 12.5px; -fx-text-fill: #475569;" VBox.vgrow="ALWAYS"/>
            <HBox alignment="CENTER_RIGHT">
                <Button fx:id="btnRestoreImport" text="Choisir un fichier (.cni, .sql, .db)..." onAction="#handleRestoreOrImport"
                        style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 10 18; -fx-background-radius: 8; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </GridPane>

    <!-- Status Banner -->
    <HBox fx:id="statusBox" alignment="CENTER_LEFT" spacing="10" visible="false" managed="false"
          style="-fx-background-color: #f0fdf4; -fx-border-color: #86efac; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 16;">
        <Label fx:id="lblStatusMessage" text="" wrapText="true"
               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #166534;"/>
    </HBox>

    <!-- Card 3: Local Automated Backups History -->
    <VBox spacing="12" VBox.vgrow="ALWAYS"
          style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 20;">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="Historique des sauvegardes automatiques locales"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                <Label fx:id="lblBackupDirectory" text="~/clinic/backups"
                       style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
            </VBox>
            <Button fx:id="btnRefreshBackups" text="Actualiser" onAction="#handleRefreshBackups"
                    style="-fx-background-color: #f1f5f9; -fx-text-fill: #334155; -fx-font-size: 12.5px; -fx-font-weight: bold; -fx-padding: 8 14; -fx-background-radius: 6; -fx-cursor: hand;"/>
            <Button fx:id="btnCopyUsb" text="Copier vers une clé USB..." onAction="#handleCopySelectedBackup"
                    style="-fx-background-color: #334155; -fx-text-fill: white; -fx-font-size: 12.5px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 6; -fx-cursor: hand;"/>
        </HBox>

        <TableView fx:id="backupTable" VBox.vgrow="ALWAYS" styleClass="modern-table">
            <columns>
                <TableColumn fx:id="colFileName" text="Nom du fichier" prefWidth="360"/>
                <TableColumn fx:id="colDate" text="Date de création" prefWidth="220"/>
                <TableColumn fx:id="colSize" text="Taille" prefWidth="140"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <placeholder>
                <Label text="Aucune sauvegarde locale trouvée." style="-fx-text-fill: #94a3b8;"/>
            </placeholder>
        </TableView>
    </VBox>

</VBox>

