<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" styleClass="main-container" stylesheets="@../../css/pages/bill.css" 
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="controller.BillController">
    <padding>
        <Insets top="20" right="30" bottom="20" left="30"/>
    </padding>

    <!-- Header Section -->
    <HBox alignment="CENTER_LEFT" spacing="20" styleClass="page-header">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Gestion des Factures" styleClass="page-title"/>
            <Label text="Suivre les paiements et factures des patients" styleClass="page-subtitle"/>
        </VBox>
        <HBox spacing="15" alignment="CENTER_RIGHT" styleClass="selector-container">
            <ComboBox fx:id="monthComboBox" promptText="Mois" styleClass="combo-box"/>
            <ComboBox fx:id="yearComboBox" promptText="Année" styleClass="combo-box"/>
        </HBox>
        <Button fx:id="btnRefresh" text="Actualiser" onAction="#handleRefresh" styleClass="btn-refresh">
            <graphic>
                <SVGPath content="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" styleClass="refresh-icon"/>
            </graphic>
            <tooltip>
                <Tooltip text="Actualiser les factures"/>
            </tooltip>
        </Button>
        <Button text="+ Nouvelle Facture" onAction="#handleNewBill" styleClass="btn-primary"/>
    </HBox>

    <!-- Table Section -->
    <VBox VBox.vgrow="ALWAYS" styleClass="table-container">
        <TableView fx:id="billTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="80" reorderable="false"/>
                <TableColumn fx:id="dateColumn" text="Date de Facturation" prefWidth="200" reorderable="false"/>
                <TableColumn fx:id="totalColumn" text="Montant Total (DZD)" prefWidth="180" style="-fx-alignment: CENTER-RIGHT;" reorderable="false"/>
                <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="150" style="-fx-alignment: CENTER;" reorderable="false"/>
            </columns>
            <placeholder>
                <Label text="Aucune facture enregistrée." />
            </placeholder>
        </TableView>
    </VBox>
</VBox>
