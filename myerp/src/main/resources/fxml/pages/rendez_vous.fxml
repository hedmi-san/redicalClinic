<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>
<?import java.net.URL?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.RendezVousController"
      spacing="0" styleClass="rendezvous-root" VBox.vgrow="ALWAYS">

    <stylesheets>
        <URL value="@../../css/pages/rendez_vous.css" />
    </stylesheets>

    <!-- Main Card Container -->
    <VBox spacing="14" VBox.vgrow="ALWAYS" styleClass="rendezvous-card">

        <!-- 1. HEADER SECTION -->
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="rdv-header">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Agenda &amp; rendez-vous" styleClass="rdv-header-title" />
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <SVGPath content="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" styleClass="clock-icon" />
                    <Label fx:id="clinicHoursSubtitle" text="Ouvert samedi → jeudi · 08:00–17:00 · rendez-vous de 30 min" styleClass="rdv-header-subtitle" />
                </HBox>
            </VBox>
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button onAction="#handleConfigureHours" text="Horaires" styleClass="btn-hdr-outline">
                    <graphic>
                        <SVGPath content="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20a2 2 0 0 0 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zM9 14H7v-2h2v2zm4 0h-2v-2h2v2zm4 0h-2v-2h2v2z" styleClass="btn-hdr-icon" />
                    </graphic>
                </Button>
                <Button onAction="#handleRefresh" styleClass="btn-hdr-icon-only">
                    <graphic>
                        <SVGPath content="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" styleClass="btn-hdr-icon" />
                    </graphic>
                </Button>
                <Button onAction="#handleAddAppointment" text="Nouveau RDV" styleClass="btn-hdr-outline">
                    <graphic>
                        <SVGPath content="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" styleClass="btn-hdr-icon" />
                    </graphic>
                </Button>
            </HBox>
        </HBox>

        <!-- 2. TOOLBAR SECTION: Toggle & Nav on Left, Stacked Filters on Right -->
        <HBox spacing="16" alignment="TOP_LEFT" styleClass="rdv-toolbar-container">
            <!-- Left Side: View Mode & Date Navigation -->
            <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS">
                <!-- Segmented View Switch -->
                <HBox styleClass="view-mode-group">
                    <ToggleButton fx:id="btnModeDay" text="Jour" selected="true" styleClass="view-mode-btn" />
                    <ToggleButton fx:id="btnModeWeek" text="Semaine" styleClass="view-mode-btn" />
                    <ToggleButton fx:id="btnModeMonth" text="Mois" styleClass="view-mode-btn" />
                </HBox>

                <!-- Nav buttons -->
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <Button onAction="#handlePrevPeriod" styleClass="btn-nav-arrow">
                        <graphic>
                            <SVGPath content="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z" styleClass="nav-arrow-icon" />
                        </graphic>
                    </Button>
                    <Button onAction="#handleToday" text="Aujourd'hui" styleClass="btn-nav-today" />
                    <Button onAction="#handleNextPeriod" styleClass="btn-nav-arrow">
                        <graphic>
                            <SVGPath content="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z" styleClass="nav-arrow-icon" />
                        </graphic>
                    </Button>
                </HBox>

                <!-- Period Title Label -->
                <Label fx:id="periodTitleLabel" text="dimanche 8 novembre 2026" styleClass="period-title-label" />

                <!-- Calendar Trigger DatePicker -->
                <DatePicker fx:id="jumpDatePicker" styleClass="calendar-trigger-picker" />
            </HBox>

            <!-- Right Side: Stacked Combos -->
            <VBox spacing="8" alignment="TOP_RIGHT">
                <ComboBox fx:id="workerFilterCombo" prefWidth="260" promptText="Tous les praticiens" styleClass="filter-combo" />
                <ComboBox fx:id="statusFilterCombo" prefWidth="260" promptText="Tous les statuts" styleClass="filter-combo" />
            </VBox>
        </HBox>

        <!-- 3. STAT CHIPS ROW -->
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="stat-chips-row">
            <HBox alignment="CENTER_LEFT" spacing="6" styleClass="stat-chip">
                <Circle radius="3.5" fill="#2563eb" />
                <Label text="Prévus / confirmés" styleClass="stat-chip-label" />
                <Label fx:id="upcomingCountLabel" text="0" styleClass="stat-chip-value" />
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="6" styleClass="stat-chip">
                <Circle radius="3.5" fill="#16a34a" />
                <Label text="Terminés" styleClass="stat-chip-label" />
                <Label fx:id="completedCountLabel" text="0" styleClass="stat-chip-value" />
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="6" styleClass="stat-chip">
                <Circle radius="3.5" fill="#dc2626" />
                <Label text="Annulés / absents" styleClass="stat-chip-label" />
                <Label fx:id="canceledCountLabel" text="0" styleClass="stat-chip-value" />
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <Label fx:id="periodScopeLabel" text="Ce jour" styleClass="period-scope-label" />
        </HBox>

        <!-- 4. ACTIVE VIEW (Daily, Weekly, Monthly) -->
        <StackPane fx:id="scheduleViewContainer" VBox.vgrow="ALWAYS">

            <!-- 1. DAILY VIEW -->
            <VBox fx:id="dailyViewBox" VBox.vgrow="ALWAYS">
                <TableView fx:id="dailyTable" VBox.vgrow="ALWAYS" styleClass="modern-table">
                    <columns>
                        <TableColumn fx:id="colTime" prefWidth="110" minWidth="90" text="Heure" />
                        <TableColumn fx:id="colPatient" prefWidth="260" minWidth="200" text="Patient" />
                        <TableColumn fx:id="colMotif" prefWidth="300" minWidth="220" text="Motif &amp; praticien" />
                        <TableColumn fx:id="colStatus" prefWidth="130" minWidth="110" text="Statut" />
                        <TableColumn fx:id="colActions" prefWidth="220" minWidth="180" text="" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>

            <!-- 2. WEEKLY VIEW -->
            <VBox fx:id="weeklyViewBox" VBox.vgrow="ALWAYS" visible="false" managed="false" spacing="8">
                <GridPane fx:id="weeklyGrid" hgap="10" vgap="10" VBox.vgrow="ALWAYS" />
            </VBox>

            <!-- 3. MONTHLY VIEW -->
            <VBox fx:id="monthlyViewBox" VBox.vgrow="ALWAYS" visible="false" managed="false" spacing="6">
                <GridPane fx:id="monthlyHeaderGrid" hgap="8" />
                <GridPane fx:id="monthlyGrid" hgap="8" vgap="8" VBox.vgrow="ALWAYS" />
            </VBox>

        </StackPane>

    </VBox>
</VBox>
