<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<?import java.net.URL?>

<VBox fx:id="mainContainer" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="controller.PatientController" 
      spacing="15" style="-fx-padding: 20;">
    <stylesheets>
        <URL value="@../../css/pages/patient.css" />
    </stylesheets>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Rechercher par nom ou téléphone..." prefWidth="280" />
        <ComboBox fx:id="balanceFilterCombo" prefWidth="170" promptText="Tous les soldes" styleClass="filter-combo" />
        <Label fx:id="patientCountLabel" text="0 patient" styleClass="patient-count-label" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnRefresh" text="Actualiser" styleClass="btn-refresh" onAction="#handleRefresh">
            <graphic>
                <SVGPath content="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" styleClass="refresh-icon" />
            </graphic>
            <tooltip>
                <Tooltip text="Actualiser les patients" />
            </tooltip>
        </Button>
        <Button text="Ajouter" styleClass="action-button, primary-button" onAction="#handleNewPatient" />
    </HBox>

    <TableView fx:id="patientTable" VBox.vgrow="ALWAYS" styleClass="modern-table">
        <columns>
            <TableColumn fx:id="nameColumn" text="Nom Complet" prefWidth="300" />
            <TableColumn fx:id="phoneColumn" text="Téléphone" prefWidth="200" />
            <TableColumn fx:id="balanceColumn" text="Solde" prefWidth="150" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>
</VBox>
