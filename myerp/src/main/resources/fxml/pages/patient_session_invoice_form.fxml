<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.PatientSessionInvoiceFormController"
      styleClass="modal" spacing="16" prefWidth="760" prefHeight="530">
    <stylesheets>
        <URL value="@../../css/pages/patient.css" />
    </stylesheets>

    <!-- Header with Title & Patient Account Status -->
    <VBox spacing="8">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label text="🧾 Sélectionner les séances pour la facture" styleClass="modal-title" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="patientBalanceBadge" text="Solde : 0,00 DZD" styleClass="badge, badge-full" />
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="Patient :" style="-fx-text-fill: #64748b; -fx-font-size: 13px; -fx-font-weight: bold;" />
            <Label fx:id="patientNameLabel" text="-" style="-fx-text-fill: #1e293b; -fx-font-size: 13px; -fx-font-weight: bold;" />
        </HBox>
    </VBox>

    <!-- Select All Toolbar -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <CheckBox fx:id="selectAllCheckBox" text="Tout sélectionner" style="-fx-font-weight: bold; -fx-text-fill: #334155;" />
    </HBox>

    <!-- Sessions Table -->
    <TableView fx:id="sessionTable" VBox.vgrow="ALWAYS" styleClass="modern-table" editable="true">
        <columns>
            <TableColumn fx:id="selectColumn" text="" prefWidth="45" sortable="false" />
            <TableColumn fx:id="dateColumn" text="Date" prefWidth="110" />
            <TableColumn fx:id="treatmentColumn" text="Traitement / Prestation" prefWidth="280" />
            <TableColumn fx:id="costColumn" text="Coût (DZD)" prefWidth="120" />
            <TableColumn fx:id="statusColumn" text="Prise en charge" prefWidth="150" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <!-- Live Counter and Action Buttons -->
    <HBox alignment="CENTER_LEFT" spacing="16" styleClass="modal-actions">
        <Label fx:id="selectionSummaryLabel" text="0 séance(s) sélectionnée(s) — Total : 0,00 DZD"
               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #0d9488;" />
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Annuler" onAction="#handleCancel" styleClass="btn-ghost" />
        <Button fx:id="btnOk" text="Générer la facture" onAction="#handleOk" styleClass="btn-teal" />
    </HBox>
</VBox>
